if(NOT NEKO_PROTO_BUILD_MODULES)
    return()
endif()
if(CMAKE_VERSION VERSION_LESS 3.28)
    message(FATAL_ERROR "NEKO_PROTO_BUILD_MODULES requires CMake 3.28 or newer")
endif()

# All BMIs and header consumers use the same frozen capability configuration.
include(CheckCXXSourceCompiles)
include(CMakePushCheckState)
set(_neko_module_standard 20)
if(CMAKE_CXX_STANDARD GREATER 20)
    set(_neko_module_standard "${CMAKE_CXX_STANDARD}")
endif()
set(_neko_module_native 0)
if(NOT NEKO_PROTO_REFLECTION_BACKEND STREQUAL "legacy" AND
   (NEKO_PROTO_REFLECTION_WITHOUT_FLAG OR NEKO_PROTO_REFLECTION_WITH_FLAG))
    set(_neko_module_native 1)
    set(_neko_module_standard 26)
endif()
function(_neko_probe_module_syntax)
    set(CMAKE_CXX_STANDARD "${_neko_module_standard}")
    set(CMAKE_CXX_STANDARD_REQUIRED ON)
    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_INCLUDES "${CMAKE_CURRENT_BINARY_DIR}/generated" "${CMAKE_CURRENT_SOURCE_DIR}/include")
    check_cxx_source_compiles("#include <nekoproto/reflection/features.hpp>\n#if !NEKO_HAS_STRUCTURED_BINDING_PACKS\n#error no binding packs\n#endif\nint main() {}" NEKO_PROTO_REFLECTION_MODULE_BINDING_PACKS)
    check_cxx_source_compiles("#include <nekoproto/reflection/features.hpp>\n#if !NEKO_HAS_PACK_INDEXING\n#error no pack indexing\n#endif\nint main() {}" NEKO_PROTO_REFLECTION_MODULE_PACK_INDEXING)
    cmake_pop_check_state()
endfunction()
_neko_probe_module_syntax()
foreach(_feature IN ITEMS BINDING_PACKS PACK_INDEXING)
    if(_feature STREQUAL "BINDING_PACKS")
        set(_macro NEKO_USE_STRUCTURED_BINDING_PACKS)
    else()
        set(_macro NEKO_USE_PACK_INDEXING)
    endif()
    set(_use 0)
    if(NEKO_PROTO_${_feature} STREQUAL "on" OR
       (NEKO_PROTO_${_feature} STREQUAL "auto" AND NEKO_PROTO_REFLECTION_MODULE_${_feature}))
        set(_use 1)
    endif()
    target_compile_definitions(NekoProtoReflection INTERFACE ${_macro}=${_use})
endforeach()
target_compile_definitions(NekoProtoReflection INTERFACE
    NEKO_USE_NATIVE_REFLECTION=${_neko_module_native}
    NEKO_USE_EXPANSION_STATEMENTS=$<BOOL:${NEKO_PROTO_EXPANSION_STATEMENTS}>)

function(_neko_add_module component module_name)
    set(_target "NekoProto${component}Module")
    add_library(${_target} STATIC)
    add_library(NekoProto::${component}Module ALIAS ${_target})
    set_target_properties(${_target} PROPERTIES EXPORT_NAME ${component}Module CXX_SCAN_FOR_MODULES ON)
    target_link_libraries(${_target} PUBLIC ${ARGN})
    target_sources(${_target} PUBLIC FILE_SET CXX_MODULES
        BASE_DIRS "${PROJECT_SOURCE_DIR}/modules" FILES "${PROJECT_SOURCE_DIR}/modules/nekoproto.${module_name}.cppm")
    set_property(GLOBAL APPEND PROPERTY NEKO_PROTO_MODULE_TARGETS ${_target})
endfunction()

# Ilias ships its own module interface. Build that source with the same
# compiler/language configuration, rather than copying its declarations here.
if(NEKO_PROTO_ENABLE_COMMUNICATION OR NEKO_PROTO_ENABLE_JSONRPC)
    set(_neko_ilias_module_hints "${NEKO_PROTO_ILIAS_ROOT}/include")
    if(TARGET "${_neko_ilias_target}")
        get_target_property(_neko_ilias_source_dir "${_neko_ilias_target}" SOURCE_DIR)
        list(APPEND _neko_ilias_module_hints "${_neko_ilias_source_dir}/include")
        get_target_property(_neko_ilias_include_dirs "${_neko_ilias_target}" INTERFACE_INCLUDE_DIRECTORIES)
        foreach(_dir IN LISTS _neko_ilias_include_dirs)
            if(_dir MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                list(APPEND _neko_ilias_module_hints "${CMAKE_MATCH_1}")
            elseif(NOT _dir MATCHES "\\$<")
                list(APPEND _neko_ilias_module_hints "${_dir}")
            endif()
        endforeach()
    endif()
    find_file(NEKO_PROTO_ILIAS_MODULE_SOURCE NAMES ilias.cppm HINTS ${_neko_ilias_module_hints})
    if(NOT NEKO_PROTO_ILIAS_MODULE_SOURCE)
        message(FATAL_ERROR "Module mode requires Ilias' ilias.cppm and ilias.hpp. Use an Ilias installation with module sources, or enable NEKO_PROTO_FETCH_MISSING_DEPS with no preselected header-only Ilias installation. NEKO_PROTO_ILIAS_MODULE_SOURCE can point to the matching upstream source.")
    endif()
    get_filename_component(_neko_ilias_module_dir "${NEKO_PROTO_ILIAS_MODULE_SOURCE}" DIRECTORY)
    find_path(NEKO_PROTO_ILIAS_MODULE_INCLUDE_DIR NAMES ilias.hpp
        HINTS "${_neko_ilias_module_dir}" ${_neko_ilias_module_hints})
    if(NOT NEKO_PROTO_ILIAS_MODULE_INCLUDE_DIR)
        message(FATAL_ERROR "The Ilias module installation is missing ilias.hpp; install its module headers alongside ilias.cppm.")
    endif()
    add_library(NekoProtoIliasModule STATIC)
    add_library(NekoProto::IliasModule ALIAS NekoProtoIliasModule)
    set_target_properties(NekoProtoIliasModule PROPERTIES EXPORT_NAME IliasModule CXX_SCAN_FOR_MODULES ON)
    target_link_libraries(NekoProtoIliasModule PUBLIC NekoProto::Ilias NekoProtoReflection)
    target_include_directories(NekoProtoIliasModule PRIVATE "${NEKO_PROTO_ILIAS_MODULE_INCLUDE_DIR}")
    target_sources(NekoProtoIliasModule PUBLIC FILE_SET CXX_MODULES
        BASE_DIRS "${_neko_ilias_module_dir}" FILES "${NEKO_PROTO_ILIAS_MODULE_SOURCE}")
    set_property(GLOBAL APPEND PROPERTY NEKO_PROTO_MODULE_TARGETS NekoProtoIliasModule)
endif()

_neko_add_module(Reflection reflect NekoProtoReflection)
_neko_add_module(Serializer serializer NekoProtoSerializer NekoProtoReflectionModule)
_neko_add_module(ArgParser argparser NekoProtoArgParser NekoProtoSerializerModule)
if(NEKO_PROTO_ENABLE_PROTOCOL)
    _neko_add_module(Protocol proto NekoProtoProtocol NekoProtoSerializerModule)
endif()
if(NEKO_PROTO_ENABLE_COMMUNICATION OR NEKO_PROTO_ENABLE_JSONRPC)
    _neko_add_module(Transport transport NekoProtoSerializer NekoProtoIliasModule NekoProtoSerializerModule)
endif()
if(NEKO_PROTO_ENABLE_JSONRPC)
    _neko_add_module(Rpc rpc NekoProtoJsonRpc NekoProtoTransportModule)
    _neko_add_module(JsonRpc jsonrpc NekoProtoJsonRpc NekoProtoRpcModule)
endif()
if(NEKO_PROTO_ENABLE_COMMUNICATION)
    _neko_add_module(Communication communication NekoProtoCommunication NekoProtoProtocolModule NekoProtoTransportModule)
endif()
get_property(_neko_module_targets GLOBAL PROPERTY NEKO_PROTO_MODULE_TARGETS)
install(TARGETS ${_neko_module_targets} EXPORT NekoProtoToolsTargets
    ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
    FILE_SET CXX_MODULES DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/nekoproto/modules")
