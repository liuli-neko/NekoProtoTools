@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsExpected.cmake")
if(NOT NEKO_PROTO_EXPECTED_FOUND)
    set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_EXPECTED_DIAGNOSTIC}")
    set(NekoProtoTools_FOUND FALSE)
    return()
endif()
if(@NEKO_PROTO_ENABLE_RAPIDJSON@)
    include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsRapidJSON.cmake")
    if(NOT NEKO_PROTO_RAPIDJSON_FOUND)
        set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_RAPIDJSON_DIAGNOSTIC}")
        set(NekoProtoTools_FOUND FALSE)
        return()
    endif()
endif()
if(@NEKO_PROTO_ENABLE_YYJSON@)
    include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsYyJSON.cmake")
    if(NOT NEKO_PROTO_YYJSON_FOUND)
        set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_YYJSON_DIAGNOSTIC}")
        set(NekoProtoTools_FOUND FALSE)
        return()
    endif()
endif()
if(@NEKO_PROTO_ENABLE_SIMDJSON@)
    include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsSimdJSON.cmake")
    if(NOT NEKO_PROTO_SIMDJSON_FOUND)
        set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_SIMDJSON_DIAGNOSTIC}")
        set(NekoProtoTools_FOUND FALSE)
        return()
    endif()
endif()
if(@NEKO_PROTO_ENABLE_PUGIXML@)
    include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsPugiXml.cmake")
    if(NOT NEKO_PROTO_PUGIXML_FOUND)
        set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_PUGIXML_DIAGNOSTIC}")
        set(NekoProtoTools_FOUND FALSE)
        return()
    endif()
endif()
if(@NEKO_PROTO_ENABLE_YAMLCPP@)
    include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsYamlCpp.cmake")
    if(NOT NEKO_PROTO_YAMLCPP_FOUND)
        set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_YAMLCPP_DIAGNOSTIC}")
        set(NekoProtoTools_FOUND FALSE)
        return()
    endif()
endif()
if(@NEKO_PROTO_ENABLE_LIBFYAML@)
    include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsLibfyaml.cmake")
    if(NOT NEKO_PROTO_LIBFYAML_FOUND)
        set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_LIBFYAML_DIAGNOSTIC}")
        set(NekoProtoTools_FOUND FALSE)
        return()
    endif()
endif()
if(@NEKO_PROTO_ENABLE_TOMLPLUSPLUS@)
    include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsTomlPlusPlus.cmake")
    if(NOT NEKO_PROTO_TOMLPLUSPLUS_FOUND)
        set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_TOMLPLUSPLUS_DIAGNOSTIC}")
        set(NekoProtoTools_FOUND FALSE)
        return()
    endif()
endif()
if(@NEKO_PROTO_ENABLE_COMMUNICATION@ OR @NEKO_PROTO_ENABLE_JSONRPC@)
    include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsIlias.cmake")
    if(NOT NEKO_PROTO_ILIAS_FOUND)
        set(NekoProtoTools_NOT_FOUND_MESSAGE "${NEKO_PROTO_ILIAS_DIAGNOSTIC}")
        set(NekoProtoTools_FOUND FALSE)
        return()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NekoProtoToolsTargets.cmake")
check_required_components(NekoProtoTools)
