set(NEKO_PROTO_REFLECTION_BACKEND "legacy" CACHE STRING "Reflection backend: legacy, native, auto")
set_property(CACHE NEKO_PROTO_REFLECTION_BACKEND PROPERTY STRINGS legacy native auto)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" _neko_probe_source)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/include/nekoproto/reflection/features.hpp" _neko_probe_features)
string(SHA256 _neko_probe_key "${_neko_probe_source};${_neko_probe_features};${CMAKE_CXX_COMPILER};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_CXX_STANDARD};${CMAKE_CXX_FLAGS};${NEKO_PROTO_REFLECTION_BACKEND}")
if(NOT NEKO_PROTO_REFLECTION_PROBE_KEY STREQUAL _neko_probe_key)
    foreach(_probe IN ITEMS WITHOUT_FLAG WITH_FLAG MODULE_BINDING_PACKS MODULE_PACK_INDEXING)
        unset(NEKO_PROTO_REFLECTION_${_probe} CACHE)
    endforeach()
    set(NEKO_PROTO_REFLECTION_PROBE_KEY "${_neko_probe_key}" CACHE INTERNAL "Reflection probe configuration")
endif()
set(NEKO_PROTO_BINDING_PACKS "auto" CACHE STRING "Structured binding packs: auto, on, off")
set(NEKO_PROTO_PACK_INDEXING "auto" CACHE STRING "Tag pack indexing: auto, on, off")
option(NEKO_PROTO_EXPANSION_STATEMENTS "Use expansion statements in short-circuit traversal" OFF)
if(NEKO_PROTO_REFLECTION_BACKEND STREQUAL "legacy")
    set(_neko_reflection_backend 0)
elseif(NEKO_PROTO_REFLECTION_BACKEND STREQUAL "native")
    set(_neko_reflection_backend 1)
elseif(NEKO_PROTO_REFLECTION_BACKEND STREQUAL "auto")
    set(_neko_reflection_backend 2)
else()
    message(FATAL_ERROR "NEKO_PROTO_REFLECTION_BACKEND must be legacy, native or auto")
endif()

add_library(NekoProtoReflection INTERFACE)
add_library(NekoProto::Reflection ALIAS NekoProtoReflection)
set_target_properties(NekoProtoReflection PROPERTIES EXPORT_NAME Reflection)
target_compile_features(NekoProtoReflection INTERFACE cxx_std_20)
target_compile_definitions(NekoProtoReflection INTERFACE NEKO_PROTO_REFLECTION_BACKEND=${_neko_reflection_backend})
foreach(_feature IN ITEMS BINDING_PACKS PACK_INDEXING)
    set_property(CACHE NEKO_PROTO_${_feature} PROPERTY STRINGS auto on off)
    if(_feature STREQUAL "BINDING_PACKS")
        set(_macro NEKO_USE_STRUCTURED_BINDING_PACKS)
    else()
        set(_macro NEKO_USE_PACK_INDEXING)
    endif()
    if(NEKO_PROTO_${_feature} STREQUAL "on")
        target_compile_definitions(NekoProtoReflection INTERFACE ${_macro}=1)
    elseif(NEKO_PROTO_${_feature} STREQUAL "off")
        target_compile_definitions(NekoProtoReflection INTERFACE ${_macro}=0)
    elseif(NOT NEKO_PROTO_${_feature} STREQUAL "auto")
        message(FATAL_ERROR "NEKO_PROTO_${_feature} must be auto, on or off")
    endif()
endforeach()
if(NEKO_PROTO_EXPANSION_STATEMENTS)
    target_compile_definitions(NekoProtoReflection INTERFACE NEKO_USE_EXPANSION_STATEMENTS=1)
endif()
target_include_directories(NekoProtoReflection INTERFACE
    $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/generated>
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)

if(NOT NEKO_PROTO_REFLECTION_BACKEND STREQUAL "legacy")
    include(CheckCXXSourceCompiles)
    include(CMakePushCheckState)
    function(_neko_probe_native_reflection)
        set(CMAKE_CXX_STANDARD 20)
        if(NEKO_PROTO_REFLECTION_BACKEND STREQUAL "native")
            set(CMAKE_CXX_STANDARD 26)
        elseif(_neko_requested_standard GREATER 20)
            set(CMAKE_CXX_STANDARD "${_neko_requested_standard}")
        endif()
        if(CMAKE_CXX_STANDARD GREATER_EQUAL 26 AND CMAKE_VERSION VERSION_LESS 3.25)
            message(FATAL_ERROR "C++26 build configuration requires CMake 3.25 or newer")
        endif()
        set(CMAKE_CXX_STANDARD_REQUIRED ON)
        cmake_push_check_state(RESET)
        set(CMAKE_REQUIRED_INCLUDES "${CMAKE_CURRENT_BINARY_DIR}/generated" "${CMAKE_CURRENT_SOURCE_DIR}/include")
        # Standard selection is handled by CMake; compiler-specific enablement is
        # accepted only after compiling the standard macros and actual API.
        check_cxx_source_compiles("#include <nekoproto/reflection/features.hpp>\n#if !NEKO_HAS_NATIVE_REFLECTION\n#error reflection unavailable\n#endif\n#include <meta>\nint main() { static_assert(std::meta::is_type(^^int)); }" NEKO_PROTO_REFLECTION_WITHOUT_FLAG)
        if(NOT NEKO_PROTO_REFLECTION_WITHOUT_FLAG)
            set(CMAKE_REQUIRED_FLAGS "-freflection")
            check_cxx_source_compiles("#include <nekoproto/reflection/features.hpp>\n#if !NEKO_HAS_NATIVE_REFLECTION\n#error reflection unavailable\n#endif\n#include <meta>\nint main() { static_assert(std::meta::is_type(^^int)); }" NEKO_PROTO_REFLECTION_WITH_FLAG)
        endif()
        cmake_pop_check_state()
    endfunction()
    set(_neko_requested_standard "${CMAKE_CXX_STANDARD}")
    _neko_probe_native_reflection()
    if(NEKO_PROTO_REFLECTION_WITHOUT_FLAG OR NEKO_PROTO_REFLECTION_WITH_FLAG)
        target_compile_features(NekoProtoReflection INTERFACE cxx_std_26)
        if(NOT NEKO_PROTO_REFLECTION_WITHOUT_FLAG)
            target_compile_options(NekoProtoReflection INTERFACE -freflection)
        endif()
    elseif(NEKO_PROTO_REFLECTION_BACKEND STREQUAL "native")
        message(FATAL_ERROR "Native reflection probe failed. Use legacy/auto or a compiler providing the standard reflection feature macros.")
    endif()
endif()

